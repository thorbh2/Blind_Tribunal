# Ritual Blind Tribunal
# Copy to .env and fill locally. Never paste private keys in Discord, GitHub, tickets, screenshots, or chat.

RITUAL_RPC_URL=https://rpc.ritualfoundation.org
RITUAL_CHAIN_ID=1979

# Wallet 2 burner deployer. Must be 0x + 64 hex chars.
WALLET2_PRIVATE_KEY=

# Optional alias. Leave empty if WALLET2_PRIVATE_KEY is set.
DEPLOYER_PRIVATE_KEY=

# Frontend public values.
VITE_RITUAL_RPC_URL=https://rpc.ritualfoundation.org
VITE_RITUAL_CHAIN_ID=1979
VITE_BLIND_TRIBUNAL_ADDRESS=
